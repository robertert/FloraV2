CONFIG_IDF_TARGET="esp32s3"

# Plytki maja uklad N16R8, czyli 16 MB flasha. Bez tego bootloader zglasza
# przy kazdym starcie, ze wykryty rozmiar jest wiekszy niz w naglowku obrazu,
# i uzywa mniejszego - czyli marnuje 14 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Wlasna tablica partycji (node/partitions.csv): dwa sloty po 3 MB pod OTA,
# NVS w tym samym miejscu co w dawnym ukladzie "single app large", wiec
# przejscie nie kasuje kalibracji. Zmiana tablicy = flashowanie kablem.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Nowa wersja po OTA startuje "na probe". Jesli sie nie potwierdzi
# (flora_ota: minuta stabilnego polaczenia z MQTT), albo padnie przed
# potwierdzeniem, bootloader wraca do poprzedniej.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Logi: domyslnie I, ale D wkompilowane, zeby dalo sie je wlaczyc zdalnie
# dla jednego modulu (headcmd/log "slow D").
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# PSRAM: plytki to warianty N16R8, czyli 8 MB pamieci w trybie oktalnym.
# Bez tego nie zmiesci sie bufor klatki kamery (320x240 szarosci to 76,8 kB
# na bufor, a uzywamy dwoch), a esp_camera_init zawiodloby w czasie pracy
# z blednym komunikatem o braku pamieci.
#
# Uwaga: domyslny tryb to QUAD, wiec dla R8 trzeba go zmienic jawnie -
# inaczej pamiec nie zostanie w ogole wykryta.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Autofokus OV5640. Domyslnie w komponencie wylaczony, a bez tego wskazniki
# funkcji AF sa NULL i nie da sie nawet SPRAWDZIC, czy modul ma silniczek.
CONFIG_CAMERA_AF_SUPPORT=y

# Pamiec wewnetrzna (22.11.2026). Detektor AprilTag (head_tags.c) robi
# mnostwo malych alokacji i zjadal caly wewnetrzny RAM (wolne 6 kB, minimum
# 0) - drugie polaczenie TLS (OTA obok MQTT) padalo na braku pamieci
# (mbedtls -0x008D = PSA_ERROR_INSUFFICIENT_MEMORY). Bufory TLS do PSRAM,
# zwykle malloc do PSRAM (AprilTag ma tysiace malych alokacji - przy progu
# 4 kB dalej zostawial 11 kB wolnego), 64 kB wewnetrznego zostaje dla WiFi
# i sterownikow, ktore i tak prosza o pamiec wewnetrzna jawnie.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
