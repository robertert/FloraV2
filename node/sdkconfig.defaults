CONFIG_IDF_TARGET="esp32s3"

# Plytki maja uklad N16R8, czyli 16 MB flasha. Bez tego bootloader zglasza
# przy kazdym starcie, ze wykryty rozmiar jest wiekszy niz w naglowku obrazu,
# i uzywa mniejszego - czyli marnuje 14 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Domyslna partycja aplikacji ma 1 MB i przy samym stosie sieciowym
# (lwIP, supplicant, mbedTLS) zostaje z niej 10% wolnego. Po dolozeniu BLE
# albo kamery zabraklo by miejsca. Ten uklad daje 1500 kB.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# PSRAM: plytki to warianty N16R8, czyli 8 MB pamieci w trybie oktalnym.
# Bez tego nie zmiesci sie bufor klatki kamery (320x240 szarosci to 76,8 kB
# na bufor, a uzywamy dwoch), a esp_camera_init zawiodloby w czasie pracy
# z blednym komunikatem o braku pamieci.
#
# Uwaga: domyslny tryb to QUAD, wiec dla R8 trzeba go zmienic jawnie -
# inaczej pamiec nie zostanie w ogole wykryta.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Autofokus OV5640. Domyslnie w komponencie wylaczony, a bez tego wskazniki
# funkcji AF sa NULL i nie da sie nawet SPRAWDZIC, czy modul ma silniczek.
CONFIG_CAMERA_AF_SUPPORT=y
