# Caddy sam pobiera i odnawia certyfikat z Let's Encrypt dla DOMAIN.
# Przy DOMAIN=localhost (test na laptopie) uzywa wlasnego, lokalnego CA.
{
	email {$ACME_EMAIL}
	# Wymuszamy Let's Encrypt, bez zapasowego ZeroSSL - renew-certs.sh
	# i tak szuka pliku po nazwie domeny, ale jeden wystawca to prostszy obraz.
	cert_issuer acme
}

{$DOMAIN} {
	encode gzip

	# Panel debugowy (tools/dashboard) - sam laczy sie z /mqtt nizej.
	handle_path /panel/* {
		root * /srv/panel
		file_server
	}
	redir /panel /panel/

	# Firmware dla OTA (flora-deploy "ota ..." zapisuje tu pliki z CI).
	# Z loginem robota: binarka zawiera domyslne haslo WiFi z flora_board.h,
	# wiec nie moze byc publiczna. OTA_PASS_HASH to skrot bcrypt hasla
	# robot1 - setup.sh liczy go z MQTT_PASS_ROBOT.
	handle_path /ota/* {
		basic_auth {
			robot1 {$OTA_PASS_HASH}
		}
		root * /srv/ota
		file_server
	}

	# MQTT po WebSocket dla panelu. Logowanie i uprawnienia sprawdza broker.
	handle /mqtt {
		reverse_proxy mosquitto:9001
	}

	handle {
		reverse_proxy grafana:3000
	}
}
