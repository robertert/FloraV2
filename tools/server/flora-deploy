#!/usr/bin/env bash
# Wdrozenie wersji stacku na serwerze. Instalacja (raz, jako root):
#
#   sudo install -o root -g root -m 755 flora-deploy /usr/local/bin/flora-deploy
#
# Instalowany POZA /opt/flora, ktory sam nadpisuje - inaczej CI moglo by
# podmienic skrypt, ktory potem uruchamia jako root.
#
# Wywolanie:
#   flora-deploy v1.2.0 < pliki.tar.gz   CI: nowa wersja + pliki serwera
#                                        (z tagu server-v1.2.0, prefiks obciety)
#   flora-deploy v1.1.0                  recznie: powrot do starszej wersji
#   flora-deploy "ota hub-v1.2.0" < hub.bin   CI: firmware bryly dla OTA
#
# CI loguje sie kluczem, ktory w authorized_keys uzytkownika "deploy" ma
# wymuszona komende (patrz README), wiec moze uruchomic TYLKO ten skrypt,
# a tag przychodzi jako jedyny argument (przy OTA: "ota <wersja>" w jednym).
set -euo pipefail

# Zmienna tylko do testow. Przez wymuszona komende SSH i sudo nie da sie
# jej podac (sudo czysci srodowisko), wiec CI zawsze trafia w /opt/flora.
DIR="${FLORA_DEPLOY_DIR:-/opt/flora/tools/server}"
# Tylko te pliki wolno CI nadpisac. Sekrety (.env, passwd, certs, data)
# nigdy nie przychodza z zewnatrz.
ALLOWED="docker-compose.yml setup.sh renew-certs.sh"

# ================= OTA: firmware bryly =================
# Plik z CI ladujemy do data/ota/hub, skad serwuje go Caddy (z loginem robota).
# Sume i rozmiar liczymy TUTAJ, nie bierzemy z CI: robot porownuje z nimi
# to, co pobral, wiec musza opisywac plik, ktory faktycznie lezy na serwerze.
OTA_MAX_BYTES=$((3 * 1024 * 1024))   # rozmiar slotu w hub/partitions.csv
OTA_KEEP=5                           # tyle ostatnich wersji zostaje

if [[ "${*:-}" =~ ^ota\ (hub-v[0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
    VER="${BASH_REMATCH[1]}"
    OTA="$DIR/data/ota/hub"
    mkdir -p "$OTA"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT

    # Czytamy o bajt wiecej niz limit - tak wiadomo, ze plik byl za duzy,
    # bez wczytywania calosci czegos, co moze byc dowolnie wielkie.
    head -c $((OTA_MAX_BYTES + 1)) > "$tmp/fw.bin"
    size=$(stat -c %s "$tmp/fw.bin")
    if [ "$size" -eq 0 ] || [ "$size" -gt "$OTA_MAX_BYTES" ]; then
        echo "flora-deploy: obraz $size B poza zakresem 1..$OTA_MAX_BYTES" >&2
        exit 2
    fi
    # Obraz aplikacji ESP zaczyna sie od bajtu 0xE9 - odsiewa pomylki typu
    # wyslanie archiwum albo pliku .elf zamiast .bin.
    if [ "$(head -c 1 "$tmp/fw.bin" | od -An -tx1 | tr -d ' ')" != "e9" ]; then
        echo "flora-deploy: to nie jest obraz aplikacji ESP (brak 0xE9 na poczatku)" >&2
        exit 2
    fi
    sha=$(sha256sum "$tmp/fw.bin" | cut -d' ' -f1)
    printf '{"version":"%s","sha256":"%s","size":%s}\n' "$VER" "$sha" "$size" > "$tmp/fw.json"

    # Zapis przez mv w obrebie katalogu: robot pobierajacy w tej chwili
    # widzi albo stary, albo nowy plik, nigdy w polowie zapisany.
    install -m 644 "$tmp/fw.bin"  "$OTA/.$VER.bin.tmp"  && mv "$OTA/.$VER.bin.tmp"  "$OTA/$VER.bin"
    install -m 644 "$tmp/fw.json" "$OTA/.$VER.json.tmp" && mv "$OTA/.$VER.json.tmp" "$OTA/$VER.json"

    # latest.json tylko do przodu: ponowne wgranie starszej wersji (np.
    # przebudowa starego tagu) nie cofa "najnowszej".
    cur=$(sed -n 's/.*"version":"\([^"]*\)".*/\1/p' "$OTA/latest.json" 2>/dev/null || true)
    newest=$(printf '%s\n%s\n' "${cur:-hub-v0.0.0}" "$VER" | sort -V | tail -n 1)
    if [ "$newest" = "$VER" ]; then
        install -m 644 "$tmp/fw.json" "$OTA/.latest.json.tmp" && mv "$OTA/.latest.json.tmp" "$OTA/latest.json"
        echo "latest: $VER"
    fi

    # Sprzatanie: zostaje OTA_KEEP najnowszych wersji. Najnowsza z latest.json
    # jest zawsze wsrod nich, bo sortujemy po numerze wersji.
    ls "$OTA" | sed -n 's/^\(hub-v[0-9.]*\)\.bin$/\1/p' | sort -V | head -n -"$OTA_KEEP" \
        | while read -r old; do rm -f "$OTA/$old.bin" "$OTA/$old.json"; echo "usunieto $old"; done

    echo "ota: $VER, $size B, sha256 $sha"
    exit 0
fi

# ================= wersja stacku serwera =================
TAG="${1:-}"
# Tag trafia do .env i do nazw obrazow - dopuszczamy wylacznie vX.Y.Z,
# zeby nic innego nie przeszlo przez wymuszona komende.
if ! [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "flora-deploy: zly tag \"$TAG\", oczekiwany vX.Y.Z" >&2
    exit 2
fi
if [ ! -f "$DIR/.env" ]; then
    echo "flora-deploy: brak $DIR/.env - najpierw jednorazowo ./setup.sh" >&2
    exit 1
fi

# --- pliki serwera z CI (opcjonalnie, przy recznym powrocie brak) ---
if [ ! -t 0 ]; then
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    cat > "$tmp/in.tar.gz"
    if [ -s "$tmp/in.tar.gz" ]; then
        # Rozpakowujemy tylko nazwy z listy; sciezki z "/" czy ".." w
        # archiwum nie pasuja do zadnej z nich, wiec nie wyjda poza $tmp.
        # shellcheck disable=SC2086
        tar -xzf "$tmp/in.tar.gz" -C "$tmp" $ALLOWED
        install -m 644 "$tmp/docker-compose.yml" "$DIR/docker-compose.yml"
        install -m 755 "$tmp/setup.sh" "$DIR/setup.sh"
        install -m 755 "$tmp/renew-certs.sh" "$DIR/renew-certs.sh"
        echo "zaktualizowano pliki serwera"
    fi
fi

cd "$DIR"

# Uzupelnienia .env dla serwerow postawionych starszym setup.sh - inaczej
# nowa wersja stacku nie wstanie i test zdrowia cofnalby wdrozenie.
# Logika jak w setup.sh: skrot hasla robota dla /ota/ w Caddym.
mkdir -p data/ota/hub
# Pusty skrot liczy sie jak brak - Caddy z pustym nie wstanie.
if ! grep -q "^OTA_PASS_HASH='..*'" .env; then
    robot_pass=$(sed -n 's/^MQTT_PASS_ROBOT=//p' .env)
    hash=$(docker run --rm caddy:2.8.4 caddy hash-password --plaintext "$robot_pass" || true)
    if [ -z "$hash" ] || [ -z "$robot_pass" ]; then
        echo "flora-deploy: nie udalo sie policzyc OTA_PASS_HASH - przerywam przed zmianami" >&2
        exit 1
    fi
    grep -v '^OTA_PASS_HASH=' .env > .env.tmp || true
    echo "OTA_PASS_HASH='$hash'" >> .env.tmp
    chmod 600 .env.tmp && mv .env.tmp .env
    echo "dopisano OTA_PASS_HASH do .env"
fi

prev=$(sed -n 's/^FLORA_VERSION=//p' .env)
sed -i '/^FLORA_VERSION=/d' .env
echo "FLORA_VERSION=$TAG" >> .env
echo "wersja: ${prev:-brak} -> $TAG"

docker compose pull --quiet
# Odtwarza tylko kontenery, ktorych obraz albo konfiguracja sie zmienily.
docker compose up -d --remove-orphans

# Prosty test zdrowia: po chwili wszystkie uslugi maja dzialac. Gdy ktoras
# padla, wracamy do poprzedniej wersji - lepiej stary dzialajacy broker
# niz robot bez polaczenia.
sleep 15
expected=$(docker compose config --services | wc -l)
running=$(docker compose ps --status running --services | wc -l)
if [ "$running" -ne "$expected" ]; then
    echo "flora-deploy: dziala $running z $expected uslug:" >&2
    docker compose ps -a >&2
    if [ -n "$prev" ] && [ "$prev" != "$TAG" ] && [ "$prev" != "latest" ]; then
        echo "flora-deploy: wracam do $prev" >&2
        sed -i '/^FLORA_VERSION=/d' .env
        echo "FLORA_VERSION=$prev" >> .env
        docker compose up -d --remove-orphans
    fi
    exit 1
fi

docker image prune -f > /dev/null
echo "wdrozono $TAG, uslug: $running"
