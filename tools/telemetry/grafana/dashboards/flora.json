    {
      "id": 2,
      "type": "stat",
      "title": "Ostatni kontakt",
      "datasource": {
        "type": "influxdb",
        "uid": "flora-influx"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 120
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"flora\")\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"sys\" and r._field == \"uptime_s\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))\n  |> keep(columns: [\"_value\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "flora-influx"
          }
        }
      ],
      "description": "Ile sekund temu przyszla ostatnia telemetria systemowa (robot wysyla ja co 5 s). Pomaranczowy powyzej 30 s, czerwony powyzej 2 min."
    },
